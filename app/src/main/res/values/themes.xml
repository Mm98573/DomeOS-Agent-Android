<resources>
    <!-- Base Theme -->
    <style name="Theme.DomeOS" parent="Theme.Material3.DynamicColors.DayNight">
        <!-- Primary Colors -->
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorPrimaryContainer">@color/md_theme_light_primaryContainer</item>
        <item name="colorOnPrimary">@color/md_theme_light_onPrimary</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_light_onPrimaryContainer</item>

        <!-- Secondary Colors -->
        <item name="colorSecondary">@color/md_theme_light_secondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_light_secondaryContainer</item>
        <item name="colorOnSecondary">@color/md_theme_light_onSecondary</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_light_onSecondaryContainer</item>

        <!-- Tertiary Colors -->
        <item name="colorTertiary">@color/md_theme_light_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_light_tertiaryContainer</item>
        <item name="colorOnTertiary">@color/md_theme_light_onTertiary</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_light_onTertiaryContainer</item>

        <!-- Error Colors -->
        <item name="colorError">@color/md_theme_light_error</item>
        <item name="colorErrorContainer">@color/md_theme_light_errorContainer</item>
        <item name="colorOnError">@color/md_theme_light_onError</item>
        <item name="colorOnErrorContainer">@color/md_theme_light_onErrorContainer</item>

        <!-- Surface Colors -->
        <item name="colorSurface">@color/md_theme_light_surface</item>
        <item name="colorSurfaceDim">@color/md_theme_light_surfaceDim</item>
        <item name="colorSurfaceBright">@color/md_theme_light_surfaceBright</item>
        <item name="colorSurfaceContainer">@color/md_theme_light_surfaceContainer</item>
        <item name="colorSurfaceContainerLow">@color/md_theme_light_surfaceContainerLow</item>
        <item name="colorSurfaceContainerHigh">@color/md_theme_light_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/md_theme_light_surfaceContainerHighest</item>
        <item name="colorOnSurface">@color/md_theme_light_onSurface</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_light_onSurfaceVariant</item>

        <!-- Outline Colors -->
        <item name="colorOutline">@color/md_theme_light_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_light_outlineVariant</item>

        <!-- Shadow & Scrim -->
        <item name="colorShadow">@color/md_theme_light_shadow</item>
        <item name="colorScrim">@color/md_theme_light_scrim</item>

        <!-- Inverse Colors -->
        <item name="colorInverseSurface">@color/md_theme_light_inverseSurface</item>
        <item name="colorInverseOnSurface">@color/md_theme_light_inverseOnSurface</item>
        <item name="colorInversePrimary">@color/md_theme_light_inversePrimary</item>

        <!-- Dynamic Colors (Material You) -->
        <item name="android:forceDarkAllowed">true</item>

        <!-- Typography -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.DomeOS.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.DomeOS.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.DomeOS.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.DomeOS.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.DomeOS.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.DomeOS.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.DomeOS.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.DomeOS.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.DomeOS.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.DomeOS.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.DomeOS.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.DomeOS.LabelSmall</item>

        <!-- Shape -->
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.DomeOS.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.DomeOS.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.DomeOS.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.DomeOS.ExtraLarge</item>

        <!-- Window -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <!-- Expressive: Enable edge-to-edge -->
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>

        <!-- Ripple -->
        <item name="android:colorControlHighlight">@color/md_theme_light_primary</item>
    </style>

    <!-- Splash Theme -->
    <style name="Theme.DomeOS.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/md_theme_light_surface</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_animated</item>
        <item name="windowSplashScreenAnimationDuration">800</item>
        <item name="postSplashScreenTheme">@style/Theme.DomeOS</item>
    </style>

    <!-- Expressive Theme Override (for dynamic color schemes) -->
    <style name="Theme.DomeOS.Expressive" parent="Theme.DomeOS">
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorSecondary">@color/md_theme_light_secondary</item>
        <item name="colorTertiary">@color/md_theme_light_tertiary</item>
    </style>

    <!-- Custom Text Appearances -->
    <style name="TextAppearance.DomeOS.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@font/inter_bold</item>
        <item name="letterSpacing">-0.5sp</item>
    </style>

    <style name="TextAppearance.DomeOS.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="letterSpacing">0sp</item>
    </style>

    <style name="TextAppearance.DomeOS.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/inter_semibold</item>
    </style>

    <style name="TextAppearance.DomeOS.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/inter_semibold</item>
    </style>

    <style name="TextAppearance.DomeOS.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/inter_medium</item>
    </style>

    <style name="TextAppearance.DomeOS.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@font/inter_medium</item>
    </style>

    <style name="TextAppearance.DomeOS.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/inter_regular</item>
    </style>

    <style name="TextAppearance.DomeOS.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/inter_regular</item>
    </style>

    <style name="TextAppearance.DomeOS.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/inter_regular</item>
    </style>

    <style name="TextAppearance.DomeOS.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/inter_medium</item>
    </style>

    <style name="TextAppearance.DomeOS.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/inter_medium</item>
    </style>

    <style name="TextAppearance.DomeOS.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/inter_regular</item>
    </style>

    <!-- Custom Shapes -->
    <style name="ShapeAppearance.DomeOS.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.DomeOS.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.DomeOS.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="ShapeAppearance.DomeOS.ExtraLarge" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">32dp</item>
    </style>

    <!-- Chip Styles -->
    <style name="Widget.DomeOS.Chip" parent="Widget.Material3.Chip.Entry">
        <item name="chipCornerRadius">12dp</item>
        <item name="chipMinHeight">36dp</item>
    </style>

    <style name="Widget.DomeOS.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">16dp</item>
        <item name="chipMinHeight">36dp</item>
    </style>

    <!-- Button Styles -->
    <style name="Widget.DomeOS.Button.Filled" parent="Widget.Material3.Button.Filled">
        <item name="cornerRadius">20dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.DomeOS.Button.Outlined" parent="Widget.Material3.Button.Outlined">
        <item name="cornerRadius">20dp</item>
    </style>

    <style name="Widget.DomeOS.Button.Text" parent="Widget.Material3.Button.Text">
        <item name="cornerRadius">20dp</item>
    </style>

    <style name="Widget.DomeOS.Button.Icon" parent="Widget.Material3.Button.Icon">
        <item name="cornerRadius">100dp</item>
    </style>

    <!-- FAB Styles -->
    <style name="Widget.DomeOS.FAB" parent="Widget.Material3.FloatingActionButton">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.DomeOS.Large</item>
    </style>

    <!-- Card Styles -->
    <style name="Widget.DomeOS.Card" parent="Widget.Material3.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
    </style>

    <style name="Widget.DomeOS.Card.Elevated" parent="Widget.Material3.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">8dp</item>
    </style>

    <!-- Navigation Drawer -->
    <style name="Widget.DomeOS.NavigationView" parent="Widget.Material3.NavigationView">
        <item name="itemIconPadding">16dp</item>
        <item name="itemHorizontalPadding">16dp</item>
        <item name="itemVerticalPadding">12dp</item>
    </style>

</resources>